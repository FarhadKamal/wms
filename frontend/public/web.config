<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site for the WMS web app (port 8101). Needs the IIS "URL Rewrite" and "Application Request Routing" modules.
     Copied into dist/ by the build. See deploy/DEPLOY.md. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Browser calls /api/... on this site; IIS forwards them to the Node API, which listens only on this machine. -->
        <rule name="WMS API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8102/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Pages are re-checked on every visit, so users get a new version right after an update. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
  <!-- Built JS/CSS have the content hash in their names, so they can be cached for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
