# Copy to .env and fill in. .env is git-ignored — never commit real passwords.

# PostgreSQL on the live server. Use a dedicated user with rights on this database only.
# Special characters in the password must be URL-encoded (e.g. @ → %40, # → %23).
DATABASE_URL="postgresql://wms_app:CHANGE_ME@SERVER_HOST:5432/azneo_wms_dev?schema=public"

# API tests (npm run test:e2e) wipe and re-seed this database on every run. Name must end in _test.
TEST_DATABASE_URL="postgresql://wms_app:CHANGE_ME@SERVER_HOST:5432/azneo_wms_test?schema=public"

# API port and the web app address allowed to call it (comma-separated).
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Signs login tokens. Use a long random value (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
# Changing it logs everyone out.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS"

# First Admin account, created by the seed only when there are no users yet.
# Leave empty to have a password generated and printed once.
INITIAL_ADMIN_PASSWORD=
